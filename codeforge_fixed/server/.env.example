# --- Model providers ---
MISTRAL_API_KEY=
MISTRAL_MODEL=codestral-latest
GEMINI_API_KEY=

# Cloudflare Workers AI (Qwen3 30B A3B FP8 and any other @cf/... model) —
# needs the account ID (dashboard URL or `wrangler whoami`) and an API token
# with the "Workers AI" permission (dash.cloudflare.com/profile/api-tokens).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Cloudinary (chat/session/snapshot storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Hosting deploy ---
# Personal Access Token from a Netlify account under Anthropic's/your control
# (User settings -> Applications -> Personal access tokens). Deploys made by
# CodeForge's "Опубликовать" button run under THIS account — users never
# provide their own token. Keep this secret out of any client-visible config.
NETLIFY_TOKEN=

# --- Agent budget limits (optional — sensible defaults if unset) ---
# Tune these if agent runs are burning too many tokens or running too long.
# Warn thresholds only notify the UI; Hard thresholds actually stop the run.
BUDGET_TOKEN_WARN=60000
BUDGET_TOKEN_HARD=150000
BUDGET_TIME_WARN_MS=90000
BUDGET_TIME_HARD_MS=240000

# --- Server ---
PORT=10000
CLIENT_ORIGIN=

# --- App access secret (optional) ---
# When set, every /api/* request (from the website's own frontend or the
# Android app) must send this value in the X-App-Secret header, or it's
# rejected with 401. Leave empty to disable the check entirely (default —
# useful for local dev). Must match VITE_APP_SECRET in client/.env and
# Constants.kt (APP_SECRET) in the Android app.
APP_SHARED_SECRET=
